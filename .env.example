# Glare Room environment
#
# Local development works with no secrets: `npm run dev` uses an in-process
# realtime bus (single Node server). That local bus does NOT work on Vercel.
#
# Production on Vercel requires an Ably API key (free tier is enough):
# 1. Create an account at https://ably.com
# 2. Create an app (for example "glareroom")
# 3. Copy an API key with publish, subscribe, and presence
# 4. Paste it below and, for Vercel, add the same value in Project → Settings → Environment Variables

ABLY_API_KEY=

# Canonical public URL. Used for Open Graph previews and share metadata.
# Local:  http://localhost:3000
# Live:   https://glareroom.vercel.app
NEXT_PUBLIC_SITE_URL=

# Operator inbox. Default (and the address in legal copy) is contact@glare.com.
# Override here or in Vercel only if that inbox changes, then redeploy.
# NEXT_PUBLIC_OPERATOR_CONTACT_EMAIL is optional; if omitted,
# OPERATOR_CONTACT_EMAIL is also exposed to the UI at build time via next.config.ts.
OPERATOR_CONTACT_EMAIL=contact@glare.com
NEXT_PUBLIC_OPERATOR_CONTACT_EMAIL=
